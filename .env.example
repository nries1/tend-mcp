# Your own Tend login email — used as a path segment for the appointments
# endpoint. This server only ever authenticates as you and only ever touches
# your own account/data.
TEND_EMAIL=

# Interim auth bridge until real login() is implemented (see tendClient.ts's
# header comment for why it isn't yet). Copy the raw `Cookie:` request header
# VALUE from DevTools' Network tab -> any authenticated request -> Headers
# panel (not a HAR export, which strips it) while logged into hellotend.com.
# Expires whenever that browser session does; needs periodic manual refresh.
# Never commit this value.
TEND_COOKIE_HEADER=
