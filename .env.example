# Your own Tend login — this server only ever authenticates as you and only
# ever touches your own account/data. Never share a running instance or its
# session; each user should run their own with their own credentials.
TEND_EMAIL=
TEND_PASSWORD=

# Only needed if the real API host (found via devtools) differs from the
# guessed default in src/tendClient.ts.
# TEND_BASE_URL=
